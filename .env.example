# ============================================================
# Portal Quebra Cabeças 10 Anos — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite o .env.local no repositório.
# ============================================================

# ------------------------------------------------------------
# Banco de Dados (MySQL 8.0+)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# ------------------------------------------------------------
DATABASE_URL="mysql://qcabecas_user:SenhaSegura123!@localhost:3306/qcabecas"

# Produção (Hostinger) — banco u677463664_qcdb no mesmo servidor da aplicação.
# Caracteres especiais na senha devem ser codificados na URL (! = %21, @ = %40).
# Valores reais ficam em env_hostinger.txt (local, fora do Git) e no hPanel.
# DATABASE_URL="mysql://u677463664_qcadmin:SENHA_CODIFICADA@127.0.0.1:3306/u677463664_qcdb"

# ------------------------------------------------------------
# Auth.js v5
# AUTH_SECRET: segredo para assinar JWT — gere com:
#   openssl rand -base64 32
# AUTH_URL: URL completa da aplicação (sem trailing slash)
# ------------------------------------------------------------
AUTH_SECRET="sua-chave-secreta-aleatoria-de-32-chars-ou-mais"
AUTH_URL="http://localhost:3000"

# Configuração de sessão (opcional — padrão: "jwt")
# AUTH_SESSION_STRATEGY="jwt"

# ------------------------------------------------------------
# Resend — Envio de e-mails transacionais
# Obtenha em: https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# E-mail remetente verificado no Resend
# Exemplo: "Portal QCabeças <no-reply@quebracabecas.com.br>"
RESEND_FROM_EMAIL="Portal QCabeças <no-reply@seudominio.com.br>"

# ------------------------------------------------------------
# Upload de Arquivos (Materiais dos Alunos)
# UPLOAD_DIR: caminho absoluto na máquina/servidor
# UPLOAD_MAX_SIZE_MB: tamanho máximo por arquivo em MB
# UPLOAD_ALLOWED_TYPES: MIME types permitidos (separados por vírgula)
# ------------------------------------------------------------
UPLOAD_DIR="/var/www/qcabecas/uploads"
UPLOAD_MAX_SIZE_MB="10"
UPLOAD_ALLOWED_TYPES="application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# ------------------------------------------------------------
# Aplicação
# NODE_ENV: development | production | test
# NEXT_PUBLIC_APP_URL: URL pública da aplicação (usada em links de e-mail)
# ------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Portal Quebra Cabeças"

# ------------------------------------------------------------
# Configurações de Agendamento
# Fuso horário usado para exibição de datas (não afeta armazenamento UTC)
# ------------------------------------------------------------
TZ="America/Sao_Paulo"
NEXT_PUBLIC_TIMEZONE="America/Sao_Paulo"

# ------------------------------------------------------------
# Lembrete automático de aulas (futuro — cron job)
# Quantas horas antes da aula enviar o e-mail de lembrete
# ------------------------------------------------------------
REMINDER_HOURS_BEFORE="24"
