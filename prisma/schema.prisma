generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  email                     String               @unique @db.VarChar(255)
  passwordHash              String               @map("password_hash") @db.VarChar(255)
  name                      String               @db.VarChar(150)
  role                      Role                 @default(ALUNO)
  phone                     String?              @db.VarChar(20)
  tempPassword              String?              @map("temp_password") @db.VarChar(100)
  precoPresencial           Decimal?             @map("preco_presencial") @db.Decimal(10, 2)
  precoVirtual              Decimal?             @map("preco_virtual") @db.Decimal(10, 2)
  dataNascimento            DateTime?            @map("data_nascimento") @db.Date
  responsavelNome           String?              @map("responsavel_nome") @db.VarChar(150)
  cpfResponsavel            String?              @map("cpf_responsavel") @db.VarChar(14)
  responsavelEmail          String?              @map("responsavel_email") @db.VarChar(255)
  responsavelTelefone       String?              @map("responsavel_telefone") @db.VarChar(20)
  consentimentoLgpd         Boolean              @default(false) @map("consentimento_lgpd")
  consentimentoData         DateTime?            @map("consentimento_data")
  rua                       String?              @db.VarChar(255)
  bairro                    String?              @db.VarChar(100)
  cidade                    String?              @db.VarChar(100)
  cep                       String?              @db.VarChar(9)
  referenciaEndereco        String?              @map("referencia_endereco") @db.VarChar(255)
  escola                    String?              @db.VarChar(200)
  serie                     String?              @db.VarChar(50)
  observacoes               String?              @db.Text
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  deletedAt                 DateTime?            @map("deleted_at")
  appointmentsAsAluno       Appointment[]        @relation("AlunoAppointments")
  appointmentsAsCoordenador Appointment[]        @relation("CoordenadorAppointments")
  appointmentsAsProfessor   Appointment[]        @relation("ProfessorAppointments")
  contaAluno                ContaAluno?
  materials                 Material[]
  pagamentosGerados         PagamentoProfessor[] @relation("GeradorPagamentos")
  pagamentosRecebidos       PagamentoProfessor[] @relation("ProfessorPagamentos")
  subjectTeachers           SubjectTeacher[]
  transacoesRegistradas     TransacaoAluno[]     @relation("RegistradorTransacoes")

  @@index([role])
  @@index([deletedAt])
  @@index([role, deletedAt])
  @@map("users")
}

model Appointment {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  coordenadorId  BigInt            @map("coordenador_id") @db.UnsignedBigInt
  alunoId        BigInt            @map("aluno_id") @db.UnsignedBigInt
  professorId    BigInt            @map("professor_id") @db.UnsignedBigInt
  roomId         Int?              @map("room_id") @db.UnsignedInt
  subjectId      Int?              @map("subject_id") @db.UnsignedInt
  disciplina     String            @db.VarChar(150)
  dataHora       DateTime          @map("data_hora")
  duracaoMinutos Int               @default(60) @map("duracao_minutos") @db.SmallInt
  status         AppointmentStatus @default(AGENDADO)
  observacoes    String?           @db.Text
  valorCobrado   Decimal?          @map("valor_cobrado") @db.Decimal(10, 2)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  cancelledAt    DateTime?         @map("cancelled_at")
  aluno          User              @relation("AlunoAppointments", fields: [alunoId], references: [id])
  coordenador    User              @relation("CoordenadorAppointments", fields: [coordenadorId], references: [id])
  professor      User              @relation("ProfessorAppointments", fields: [professorId], references: [id])
  room           Room?             @relation(fields: [roomId], references: [id])
  subject        Subject?          @relation(fields: [subjectId], references: [id])
  emailLogs      EmailLog[]
  evidencia      Evidencia?
  materials      Material[]
  transacaoAluno TransacaoAluno?

  @@index([coordenadorId])
  @@index([alunoId])
  @@index([professorId])
  @@index([alunoId, dataHora])
  @@index([professorId, dataHora])
  @@index([status])
  @@index([dataHora])
  @@index([roomId], map: "appointments_room_id_fkey")
  @@index([subjectId], map: "appointments_subject_id_fkey")
  @@map("appointments")
}

model Material {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  appointmentId BigInt      @map("appointment_id") @db.UnsignedBigInt
  alunoId       BigInt      @map("aluno_id") @db.UnsignedBigInt
  originalName  String      @map("original_name") @db.VarChar(255)
  storedName    String      @map("stored_name") @db.VarChar(255)
  filepath      String      @db.VarChar(500)
  mimetype      String      @db.VarChar(100)
  sizeBytes     Int         @map("size_bytes") @db.UnsignedInt
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  aluno         User        @relation(fields: [alunoId], references: [id])
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([alunoId])
  @@index([appointmentId, alunoId])
  @@map("materials")
}

model EmailLog {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  appointmentId  BigInt      @map("appointment_id") @db.UnsignedBigInt
  recipientEmail String      @map("recipient_email") @db.VarChar(255)
  type           EmailType
  sentAt         DateTime    @default(now()) @map("sent_at")
  status         EmailStatus @default(ENVIADO)
  errorMessage   String?     @map("error_message") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  appointment    Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([status])
  @@index([type])
  @@index([sentAt])
  @@index([appointmentId, type])
  @@map("email_logs")
}

model Room {
  id                  Int           @id @default(autoincrement()) @db.UnsignedInt
  name                String        @db.VarChar(150)
  type                RoomType      @default(PRESENCIAL)
  location            String?       @db.VarChar(255)
  capacity            Int?          @db.SmallInt
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  horariosDisponiveis Json?         @map("horarios_disponiveis")
  appointments        Appointment[]

  @@index([type])
  @@index([active])
  @@map("rooms")
}

model Subject {
  id              Int              @id @default(autoincrement()) @db.UnsignedInt
  name            String           @unique @db.VarChar(100)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  appointments    Appointment[]
  subjectTeachers SubjectTeacher[]

  @@map("subjects")
}

model SubjectTeacher {
  subjectId Int      @map("subject_id") @db.UnsignedInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([subjectId, userId])
  @@index([userId], map: "subject_teachers_user_id_fkey")
  @@map("subject_teachers")
}

model Evidencia {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  appointmentId  BigInt              @unique @map("appointment_id") @db.UnsignedBigInt
  alunoNome      String              @map("aluno_nome") @db.VarChar(150)
  professorNome  String              @map("professor_nome") @db.VarChar(150)
  dataAula       DateTime            @map("data_aula")
  duracaoMinutos Int                 @map("duracao_minutos") @db.SmallInt
  disciplina     String              @db.VarChar(150)
  salaTipo       String?             @map("sala_tipo") @db.VarChar(20)
  valorProfessor Decimal             @map("valor_professor") @db.Decimal(10, 2)
  valorAluno     Decimal             @map("valor_aluno") @db.Decimal(10, 2)
  status         String              @db.VarChar(20)
  registradoEm   DateTime            @default(now()) @map("registrado_em")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  pagoProfessor  Boolean             @default(false) @map("pago_professor")
  pagamentoId    BigInt?             @map("pagamento_id") @db.UnsignedBigInt
  appointment    Appointment         @relation(fields: [appointmentId], references: [id])
  pagamento      PagamentoProfessor? @relation(fields: [pagamentoId], references: [id])

  @@index([status])
  @@index([pagoProfessor])
  @@index([registradoEm])
  @@index([pagamentoId], map: "evidencias_pagamento_id_fkey")
  @@map("evidencias")
}

model ContaAluno {
  id         Int              @id @default(autoincrement()) @db.UnsignedInt
  alunoId    BigInt           @unique @map("aluno_id") @db.UnsignedBigInt
  saldo      Decimal          @default(0.00) @map("saldo") @db.Decimal(10, 2)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  aluno      User             @relation(fields: [alunoId], references: [id])
  transacoes TransacaoAluno[]

  @@map("contas_aluno")
}

model TransacaoAluno {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  contaId       Int           @map("conta_id") @db.UnsignedInt
  tipo          TipoTransacao
  valor         Decimal       @db.Decimal(10, 2)
  descricao     String        @db.VarChar(255)
  appointmentId BigInt?       @unique @map("appointment_id") @db.UnsignedBigInt
  registradoPor BigInt        @map("registrado_por") @db.UnsignedBigInt
  createdAt     DateTime      @default(now()) @map("created_at")
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  conta         ContaAluno    @relation(fields: [contaId], references: [id])
  registrador   User          @relation("RegistradorTransacoes", fields: [registradoPor], references: [id])

  @@index([contaId])
  @@index([createdAt])
  @@index([registradoPor], map: "transacoes_aluno_registrado_por_fkey")
  @@map("transacoes_aluno")
}

model PagamentoProfessor {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  professorId   BigInt      @map("professor_id") @db.UnsignedBigInt
  professorNome String      @map("professor_nome") @db.VarChar(150)
  totalValor    Decimal     @map("total_valor") @db.Decimal(10, 2)
  aulaCount     Int         @map("aula_count") @db.SmallInt
  periodoInicio DateTime?   @map("periodo_inicio")
  periodoFim    DateTime?   @map("periodo_fim")
  observacoes   String?     @db.Text
  geradoEm      DateTime    @default(now()) @map("gerado_em")
  geradoPor     BigInt      @map("gerado_por") @db.UnsignedBigInt
  evidencias    Evidencia[]
  gerador       User        @relation("GeradorPagamentos", fields: [geradoPor], references: [id])
  professor     User        @relation("ProfessorPagamentos", fields: [professorId], references: [id])

  @@index([professorId])
  @@index([geradoEm])
  @@index([geradoPor], map: "pagamentos_professor_gerado_por_fkey")
  @@map("pagamentos_professor")
}

/// Perfil de acesso do usuário no portal.
enum Role {
  ALUNO
  PROFESSOR
  COORDENADOR
}

/// Estado do agendamento de aula.
enum AppointmentStatus {
  AGENDADO
  CANCELADO
  CONCLUIDO
}

/// Tipo de e-mail transacional enviado.
enum EmailType {
  CONFIRMACAO
  CANCELAMENTO
  LEMBRETE
}

/// Resultado do envio do e-mail.
enum EmailStatus {
  ENVIADO
  ERRO
}

enum TipoTransacao {
  CREDITO
  DEBITO
}

enum RoomType {
  PRESENCIAL
  VIRTUAL
}
