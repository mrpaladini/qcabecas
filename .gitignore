# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Arquivos enviados por usuários — nunca commitar
/uploads

# Modelo de variáveis de ambiente (sem segredos) pode ir para o repositório
!.env.example

# Scripts e logs locais de teste (contêm senhas) — nunca commitar
/_listar_usuarios.cjs
/_definir_senha.cjs
/_usuarios_teste.txt
/*_log.txt
/iniciar-dev.bat
/definir-senha-coordenador.bat

# Configurações locais do Claude
/.claude/

# Export do banco e script (contém dados pessoais e hashes) — nunca commitar
/_exportar_banco.cjs
/exportar-banco.bat
/*.sql.export
/qcabecas_export.sql
/env_hostinger.txt
/_prisma_client.tgz
